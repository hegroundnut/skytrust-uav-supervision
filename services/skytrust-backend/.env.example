# .env.example —— 真实链后端运行环境模板（可提交 Git；.gitignore 已豁免本文件）。
# 用法：cp .env.example .env，按部署实况修改路径后 `set -a; source .env; set +a` 启动。
# 安全红线（指南 §5-④）：真实证书、私钥、数据库密码和生产地址绝不写入本模板/Git——
# 下面仅为本机部署实测的**文件路径与回环地址**（非敏感），生产环境必须替换。

CHAIN_MODE=real
SERVER_ADDR=:8080
DB_PATH=data/skytrust-real.db
SM9_KEY_DIR=data/sm9

# ---- ChainMaker 监管链（solo wx-org.chainmaker.org / chain1，双证书对：TLS + 签名）----
CHAINMAKER_RPC_URL=127.0.0.1:12301
CHAINMAKER_CHAIN_ID=chain1
CHAINMAKER_ORG_ID=wx-org.chainmaker.org
CHAINMAKER_USER_KEY_FILE=/opt/chains/chainmaker/chainmaker-go/config/wx-org-solo/certs/wx-org.chainmaker.org/user/client1/client1.tls.key
CHAINMAKER_USER_CERT_FILE=/opt/chains/chainmaker/chainmaker-go/config/wx-org-solo/certs/wx-org.chainmaker.org/user/client1/client1.tls.crt
# 双证书模式：签名对（单证书环境删除这两行，SDK 以 TLS 对兼作签名）
CHAINMAKER_USER_SIGN_KEY_FILE=/opt/chains/chainmaker/chainmaker-go/config/wx-org-solo/certs/wx-org.chainmaker.org/user/client1/client1.sign.key
CHAINMAKER_USER_SIGN_CERT_FILE=/opt/chains/chainmaker/chainmaker-go/config/wx-org-solo/certs/wx-org.chainmaker.org/user/client1/client1.sign.crt
# ⚠ 信任根为**目录**（SDK conn_pool 对路径 readdir 装载全部 .crt；传单个文件报 not a directory）
CHAINMAKER_CA_CERT_FILE=/opt/chains/chainmaker/trust-roots-solo
CHAINMAKER_TLS_HOST_NAME=chainmaker.org

# ---- Fabric 运营链（test-network mychannel，Org1 Admin）----
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CERT_PATH=<repo>/platforms/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/Admin@org1.example.com-cert.pem
FABRIC_KEY_PATH=<repo>/platforms/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=<repo>/platforms/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_TLS_HOST_NAME=peer0.org1.example.com

# ---- FISCO BCOS 管理链（group0，非国密；BFS 名 /apps/uav_management）----
FISCO_RPC_URL=http://127.0.0.1:20200
FISCO_GROUP_ID=group0
FISCO_CA_CERT_PATH=/opt/fisco/console/conf/ca.crt
FISCO_SDK_CERT_PATH=/opt/fisco/console/conf/sdk.crt
FISCO_SDK_KEY_PATH=/opt/fisco/console/conf/sdk.key
FISCO_ACCOUNT_KEYSTORE=/opt/fisco/console/account/ecdsa/<account-address>.pem
FISCO_CONTRACT_CNS_NAME=uav_management

# ---- IRITA 证照链（skytrust-license，4 验证人 Tendermint BFT，SM2；无合约部署——
#      逻辑合约 license_registry 由内置 record 模块承载，见 contracts/irita/README.md。
#      写路径 = CLI shell-out（keyring-test 家目录），读路径 = 裸 TM RPC，零链 SDK 依赖）----
IRITA_RPC=http://127.0.0.1:26657
IRITA_CHAIN_ID=skytrust-license
IRITA_CLI_BIN=/opt/irita/bin/irita
IRITA_CLI_HOME=/opt/irita/cli-home
IRITA_KEY_NAME=skytrust-biz

# ---- 可选：explorer 节点清单（chainmaker/fabric 无全网节点枚举 RPC；
#      "name=addr" 逗号分隔，逐地址 TCP 探活，source=static+probe；未配置只报已知端点）----
# CHAINMAKER_NODE_LIST=org1=127.0.0.1:12301,org2=127.0.0.1:12302,org3=127.0.0.1:12303,org4=127.0.0.1:12304
# FABRIC_NODE_LIST=peer0.org1=localhost:7051,peer0.org2=localhost:9051
